{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Musyg/persistent-memory",
  "title": "persistent-memory",
  "description": "Agent memory that tracks sources and stops serving what depends on corrected or withdrawn facts.",
  "repository": {
    "url": "https://github.com/Musyg/persistent-memory",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Musyg/persistent-memory#readme",
  "version": "0.4.0a4",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "persistent-memory-mcp",
      "version": "0.4.0a4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--create",
          "description": "Create the memory store in the platform's data folder on first use."
        }
      ]
    }
  ]
}
